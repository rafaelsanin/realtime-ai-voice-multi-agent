# LiveKit Cloud (https://cloud.livekit.io) - Settings -> API Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Fixed room name the bot joins; also pin your SIP dispatch rule to this name (commit 5)
LIVEKIT_ROOM_NAME=bella-vista-line

# LLM / STT / TTS providers
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini if unset
OPENAI_MODEL=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Optional, defaults to a stock Cartesia voice if unset. Host voice.
CARTESIA_VOICE_ID=
# Optional, defaults to a distinct stock Cartesia voice if unset. Booking voice.
CARTESIA_BOOKING_VOICE_ID=

# Supabase (https://supabase.com/dashboard) - Project Settings -> Data API / API Keys
# Used from commit 3 onward for the check_availability/book_table tools.
# SUPABASE_KEY must be the "secret" key (sb_secret_...), not "publishable"
# (sb_publishable_...) -- tools need to bypass RLS to read/write reservations.
SUPABASE_URL=
SUPABASE_KEY=

# Optional, commit 6. Auto-detected from platform env vars (FLY_APP_NAME ->
# fly_io, ECS_CONTAINER_METADATA_URI_V4 -> aws_ecs, otherwise local); set
# explicitly only to override that. One of: local, fly_io, aws_ecs.
DEPLOYMENT=
# Optional, commit 6. Defaults to "console" locally and "json" on a cloud
# deployment (structured stdout for a log drain). One of: console, json.
LOG_FORMAT=
