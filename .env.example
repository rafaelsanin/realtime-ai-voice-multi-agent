# LiveKit Cloud (https://cloud.livekit.io) - Settings -> API Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Fixed room name the bot joins; also pin your SIP dispatch rule to this name (commit 5)
LIVEKIT_ROOM_NAME=bella-vista-line

# LLM / STT / TTS providers
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Supabase (https://supabase.com/dashboard) - Project Settings -> Data API / API Keys
# Used from commit 3 onward for the check_availability/book_table tools
SUPABASE_URL=
SUPABASE_KEY=
